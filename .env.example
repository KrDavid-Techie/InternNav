# Directory containing both the model folder and the DepthAnything checkpoint.
CHECKPOINTS_DIR=./checkpoints
MODEL_DIR=InternVLA-N1-DualVLN

# The robot already has this Jetson image locally. Override this for the
# NVIDIA PyTorch image or another compatible CUDA host.
INTERNVLA_BASE_IMAGE=cobiz:jetson
TORCH_WHEEL_URL=https://download-r2.pytorch.org/whl/cu126/torch-2.6.0%2Bcu126-cp310-cp310-linux_aarch64.whl
TORCHVISION_WHEEL_URL=https://download-r2.pytorch.org/whl/cu126/torchvision-0.21.0-cp310-cp310-linux_aarch64.whl
INTERNVLA_DEVICE=cuda:0
INTERNVLA_ATTN_IMPLEMENTATION=sdpa
INTERNVLA_PLAN_STEP_GAP=3
INTERNVLA_PORT=5801
INSTALL_FLASH_ATTN=0

HF_CACHE_DIR=./.cache/huggingface
OUTPUT_DIR=./output

# Optional. Leave empty to avoid accumulating debug images in the container.
# INTERNVLA_DEBUG_OUTPUT_DIR=/app/output/debug

# Optional fallback only. The robot client normally sends --instruction.
# INTERNVLA_INSTRUCTION=
